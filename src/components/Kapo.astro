---
import { getRelativeLocaleUrl } from "astro:i18n";
import { tradukilo } from "../i18n/tradukoj";

const lingvo = Astro.currentLocale ?? "eo";
const t = tradukilo(lingvo);
const uzanto = Astro.locals.uzanto;
const ensalutaUrl = `${getRelativeLocaleUrl(lingvo, "ensaluti")}?reveno=${encodeURIComponent(Astro.url.pathname)}`;
---

<header class="kapo">
  <div class="kapo-interno">
    <a class="marko" href={getRelativeLocaleUrl(lingvo, "")} aria-label={t("navigado.hejmo")}>
      <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2.5l2.9 6.2 6.6.7-4.9 4.5 1.4 6.6L12 17.2l-6 3.3 1.4-6.6-4.9-4.5 6.6-.7z"
          fill="currentColor"></path>
      </svg>
      <span>{t("retejo.nomo")}</span>
    </a>
    <nav aria-label={t("navigado.cxefa")} class="navigado">
      <a
        class="ligilo"
        href={getRelativeLocaleUrl(lingvo, "sercxi")}
        aria-current={Astro.url.pathname.replace(/\/$/, "").endsWith("/sercxi") ? "page" : undefined}
      >
        {t("navigado.sercxi")}
      </a>
      {
        uzanto ? (
          <>
            <a class="ligilo" href={getRelativeLocaleUrl(lingvo, `s/${uzanto.slug}`)}>
              {t("navigado.mia-profilo")}
            </a>
            <form method="post" action="/elsaluti">
              <input type="hidden" name="lingvo" value={lingvo} />
              <button type="submit" class="ligilo">
                {t("navigado.elsaluti")}
              </button>
            </form>
          </>
        ) : (
          !Astro.url.pathname.endsWith("/ensaluti") && (
            <a class="butono" href={ensalutaUrl}>
              {t("navigado.ensaluti")}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>

<style>
  .kapo {
    background: var(--koloro-surfaco);
    border-bottom: 1px solid var(--koloro-rando);
  }

  .kapo-interno {
    max-width: 85rem;
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .marko {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--koloro-teksto);
    font-family: var(--tiparo-titoloj);
    font-weight: 700;
    font-size: 1.375rem;
  }

  .marko svg {
    color: var(--koloro-akcento);
  }

  .navigado {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .navigado form {
    margin: 0;
  }

  .ligilo {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.875rem;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--koloro-teksto);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .ligilo:hover {
    background: var(--koloro-fono);
    color: var(--koloro-teksto);
  }

  .ligilo[aria-current="page"] {
    background: var(--koloro-akcento-hela);
    color: var(--koloro-akcento);
    font-weight: 600;
  }

  .butono {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 10px;
    background: var(--koloro-teksto);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .butono:hover {
    background: #000;
    color: #fff;
  }
</style>
