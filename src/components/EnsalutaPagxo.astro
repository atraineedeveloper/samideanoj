---
import { getRelativeLocaleUrl } from "astro:i18n";
import { env } from "cloudflare:workers";
import { tradukilo } from "../i18n/tradukoj";
import Bazo from "../layouts/Bazo.astro";
import { agordoj } from "../lib/ensaluto";
import { ekzemplajUzantoj, provaEnsalutoPermesita } from "../lib/provaEnsaluto";
import { sekuraReveno, telegramajAtributoj } from "../lib/provizantoj";

const lingvo = Astro.currentLocale ?? "eo";
const t = tradukilo(lingvo);
const { google, github, telegramo } = agordoj();
const uzanto = Astro.locals.uzanto;

const eraro = Astro.url.searchParams.get("eraro");
const reveno = sekuraReveno(Astro.url.searchParams.get("reveno"));
const parametroj = new URLSearchParams({ lingvo, ...(reveno ? { reveno } : {}) }).toString();

const telegramaRevoko = new URL(`/auth/telegramo/revoko?${parametroj}`, Astro.url.origin).href;
const iuProvizanto = Boolean(google || github || telegramo);
const provo = provaEnsalutoPermesita(env as unknown as Record<string, unknown>);
const ekzemploj = provo && !uzanto ? await ekzemplajUzantoj(env.DB) : [];
// "Daŭrigante, vi akceptas la {kondicxoj} kaj la {privateco}...": la tekstoj ĉirkaŭ la du ligiloj.
const akcepto = t("ensaluti.akcepto").split(/\{kondicxoj\}|\{privateco\}/);
---

<Bazo titolo={t("navigado.ensaluti")} sola>
  <div class="ensaluta-krado">
    <section class="verda" aria-label={t("retejo.nomo")}>
      <a class="marko" href={getRelativeLocaleUrl(lingvo, "")}>
        <svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.5 1.4 6.6L12 17.2l-6 3.3 1.4-6.6-4.9-4.5 6.6-.7z" fill="currentColor"></path></svg>
        <span>{t("retejo.nomo")}</span>
      </a>
      <div class="slogano">
        <p class="granda">{t("ensaluti.slogano")}</p>
        <p>{t("ensaluti.historio")}</p>
      </div>
      <span class="valoroj">{t("ensaluti.valoroj")}</span>
    </section>

    <main class="ensaluto">
      <a class="fermi" href={getRelativeLocaleUrl(lingvo, "")} aria-label={t("navigado.hejmo")}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </a>
      <div class="enhavo">
        <svg class="stelo" width="56" height="56" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.5 1.4 6.6L12 17.2l-6 3.3 1.4-6.6-4.9-4.5 6.6-.7z" fill="currentColor"></path>
        </svg>
        <div class="titoloj">
          <h1>{t("ensaluti.titolo")}</h1>
          <p class="subtitolo">{t("ensaluti.subtitolo")}</p>
        </div>

        {
          eraro && (
            <p class="eraro" role="alert">
              {eraro === "eksvalidigxis" ? t("aligxi.eksvalidigxis") : t("ensaluti.eraro")}
            </p>
          )
        }

        {
          uzanto ? (
            <p class="avizo">
              {t("ensaluti.jam")}{" "}
              <a href={getRelativeLocaleUrl(lingvo, `s/${uzanto.slug}`)}>{t("navigado.mia-profilo")}</a>
            </p>
          ) : !iuProvizanto ? (
            <p class="avizo">{t("ensaluti.neniu-provizanto")}</p>
          ) : (
            <div class="butonoj">
              {telegramo && (
                <div class="telegramo">
                  <script
                    is:inline
                    async
                    src="https://telegram.org/js/telegram-widget.js?22"
                    {...telegramajAtributoj(telegramo.robotoNomo, telegramaRevoko)}
                  />
                </div>
              )}
              {google && (
                <a class="butono google" href={`/auth/google?${parametroj}`}>
                  {t("ensaluti.google")}
                </a>
              )}
              {github && (
                <a class="butono github" href={`/auth/github?${parametroj}`}>
                  {t("ensaluti.github")}
                </a>
              )}
            </div>
          )
        }

        {
          ekzemploj.length > 0 && (
            <section class="provo" aria-labelledby="provo-titolo">
              <h2 id="provo-titolo">{t("provo.titolo")}</h2>
              <p>{t("provo.teksto")}</p>
              <ul>
                {ekzemploj.map((e) => (
                  <li>
                    <form method="post" action="/provo/ensaluti">
                      <input type="hidden" name="slug" value={e.slug} />
                      <input type="hidden" name="lingvo" value={lingvo} />
                      <button type="submit">
                        {e.kromnomo}
                        {e.rolo !== "uzanto" && <span class="etikedo">{t("provo.moderiganto")}</span>}
                        {e.stato !== "aktiva" && <span class="etikedo">{t("provo.kasxita")}</span>}
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <ul class="promesoj">
          {[t("ensaluti.promeso1"), t("ensaluti.promeso2"), t("ensaluti.promeso3")].map((p) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>

        <p class="akcepto">
          {akcepto[0]}<a href={getRelativeLocaleUrl(lingvo, "kondicxoj")}>{t("ensaluti.uzkondicxoj")}</a>{akcepto[1]}<a href={getRelativeLocaleUrl(lingvo, "privateco")}>{t("ensaluti.privateca-deklaro")}</a>{akcepto[2]}
        </p>
      </div>
    </main>
  </div>
</Bazo>

<style>
  .ensaluta-krado {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .verda {
    box-sizing: border-box;
    padding: 3rem 3.5rem;
    background: var(--koloro-akcento);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .verda .marko {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--tiparo-titoloj);
    font-weight: 700;
    font-size: 1.375rem;
  }

  .slogano {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32.5rem;
  }

  .slogano p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: #e3f0e7;
  }

  .slogano .granda {
    font-family: var(--tiparo-titoloj);
    font-size: clamp(2.25rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .valoroj {
    font-size: 0.875rem;
    color: #e3f0e7;
  }

  .ensaluto {
    position: relative;
    box-sizing: border-box;
    padding: 3rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .enhavo {
    width: 100%;
    max-width: 26.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .fermi,
  .stelo {
    display: none;
  }

  .titoloj {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  .subtitolo,
  .akcepto {
    margin: 0;
    line-height: 1.5;
    color: var(--koloro-teksto-dua);
  }

  .akcepto {
    font-size: 0.8125rem;
  }

  .eraro {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: #fbeae4;
    color: #85290f;
    font-weight: 600;
  }

  .avizo {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--koloro-akcento-hela);
  }

  .butonoj {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .telegramo {
    display: flex;
    justify-content: center;
    min-height: 3.375rem;
  }

  .butono {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.375rem;
    box-sizing: border-box;
    border-radius: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .google {
    background: var(--koloro-surfaco);
    border: 1px solid #c9d3cb;
    color: var(--koloro-teksto);
  }

  .google:hover {
    border-color: var(--koloro-teksto);
    color: var(--koloro-teksto);
  }

  .github {
    background: var(--koloro-teksto);
    color: #fff;
  }

  .github:hover {
    background: #000;
    color: #fff;
  }

  .promesoj {
    margin: 0;
    padding: 1.125rem;
    list-style: none;
    border: 1px solid var(--koloro-rando);
    border-radius: 14px;
    background: var(--koloro-surfaco);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .promesoj li {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .promesoj svg {
    flex: none;
    margin-top: 1px;
    color: var(--koloro-akcento);
  }

  .provo {
    padding: 1.125rem;
    border: 2px dashed #c2410c;
    border-radius: 16px;
    background: #fff7ed;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .provo h2 {
    margin: 0;
    font-size: 1.0625rem;
    color: #9a3412;
  }

  .provo p {
    margin: 0;
    font-size: 0.875rem;
  }

  .provo ul {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 0.375rem;
    max-height: 16rem;
    overflow-y: auto;
  }

  .provo form {
    margin: 0;
  }

  .provo button {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid #fdba74;
    border-radius: 10px;
    background: #fff;
    color: var(--koloro-teksto);
    font: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
  }

  .provo button:hover {
    border-color: #c2410c;
  }

  .provo .etikedo {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #9a3412;
  }

  /* Poŝtelefono (prototipo: posxtelefono/ensaluti.html): sen la verda panelo. */
  @media (max-width: 47.99rem) {
    .ensaluta-krado {
      display: block;
    }

    .verda {
      display: none;
    }

    .ensaluto {
      padding: 4.5rem 1.25rem 2rem;
      align-items: flex-start;
    }

    .fermi {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-items: center;
      color: var(--koloro-teksto);
    }

    .stelo {
      display: block;
      align-self: center;
      color: var(--koloro-akcento);
    }

    .titoloj,
    .akcepto {
      text-align: center;
    }
  }
</style>
