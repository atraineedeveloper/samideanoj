---
import { getRelativeLocaleUrl } from "astro:i18n";
import { enmeti, monatoKajJaro, nomoDe, tradukiDinamike, tradukilo } from "../i18n/tradukoj";
import Bazo from "../layouts/Bazo.astro";
import { avataraStilo } from "../lib/avataro";
import { lokaTeksto } from "../lib/formato";
import { montrebla } from "../lib/ligiloj";
import type { VideblaProfilo } from "../lib/videbleco";

interface Props {
  /** Jam filtrita profilo: neniam PlenaProfilo. */
  profilo: VideblaProfilo;
}

const lingvo = Astro.currentLocale ?? "eo";
const t = tradukilo(lingvo);
const { profilo } = Astro.props;
const ensalutaUrl = `${getRelativeLocaleUrl(lingvo, "ensaluti")}?reveno=${encodeURIComponent(Astro.url.pathname)}`;

const loko = lokaTeksto(profilo, lingvo);

const ligiloj = profilo.ligiloj.map((l) => ({
  etikedo: t(`ligilo.${l.tipo}`),
  ...(l.sxlosita
    ? { sxlosita: true as const }
    : { sxlosita: false as const, ...montrebla(l.tipo, l.valoro) }),
}));

const gxisdatigita = monatoKajJaro(new Date(profilo.gxisdatigita * 1000), lingvo);

// "Reen al la rezultoj": al la serĉo, el kiu la vizitanto venis, se ĝi estas ĉe ni.
const hejmo = getRelativeLocaleUrl(lingvo, "");
let reen = hejmo;
try {
  const de = new URL(Astro.request.headers.get("Referer") ?? "");
  if (de.origin === Astro.url.origin && /^\/((es|en)\/?)?(sercxi\/?)?$/.test(de.pathname)) {
    reen = `${de.pathname}${de.search}`;
  }
} catch {
  // Neniu aŭ nevalida Referer: al la hejmpaĝo.
}
const raportUrl = Astro.locals.uzanto
  ? getRelativeLocaleUrl(lingvo, `raporti/${profilo.slug}`)
  : `${getRelativeLocaleUrl(lingvo, "ensaluti")}?reveno=${encodeURIComponent(getRelativeLocaleUrl(lingvo, `raporti/${profilo.slug}`))}`;
const sxlositaj = profilo.ligiloj.filter((l) => l.sxlosita).length;
---

<Bazo titolo={profilo.kromnomo} senKapoPosxtelefone>
      <main class="profilo">
        <div class="supro">
          <a class="reen" href={reen}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            <span>{t("profilo.reen")}</span>
          </a>
          {
            !profilo.estasPosedanto && (
              <a class="raporti" href={raportUrl} rel="nofollow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></svg>
                <span class="nur-labortablo">{t("profilo.raporti-butono")}</span>
                <span class="nur-posxtelefono">{t("profilo.raporti-mallonge")}</span>
              </a>
            )
          }
        </div>
        {
          Astro.url.searchParams.get("konservita") === "1" && profilo.estasPosedanto && (
            <p class="avizo sukceso" role="status">{t("redakti.konservita")}</p>
          )
        }
        {
          Astro.url.searchParams.get("raportita") === "1" && !profilo.estasPosedanto && (
            <p class="avizo sukceso" role="status">{t("profilo.raportita")}</p>
          )
        }
        {
          profilo.kasxita && (
            <p class="avizo averto" role="status">
              {profilo.estasPosedanto ? t("profilo.kasxita") : t("profilo.kasxita-moderiganto")}
            </p>
          )
        }
        {
          profilo.estasPosedanto && (
            <p class="avizo">
              {t("profilo.via-profilo")}{" "}
              <a href={getRelativeLocaleUrl(lingvo, "mia-profilo")}>{t("redakti.redakti")}</a>
              {" · "}
              <a href={getRelativeLocaleUrl(lingvo, "agordoj")}>{t("profilo.agordoj")}</a>
            </p>
          )
        }

        <div class="kolumnoj">
          <section class="karto cxefa" aria-labelledby="profilo-nomo">
            <div class="identeco">
              <div class="avataro" aria-hidden="true" style={profilo.bildo ? undefined : avataraStilo(profilo.slug)}>
                {
                  profilo.bildo ? (
                    <img src={profilo.bildo} alt="" width="96" height="96" loading="lazy" />
                  ) : (
                    profilo.kromnomo.charAt(0).toUpperCase()
                  )
                }
              </div>
              <div class="nomo-bloko">
                <h1 id="profilo-nomo">{profilo.kromnomo}</h1>
                <div class="meta">
                  <span class="nivelo">{t(`nivelo.${profilo.nivelo}`)}</span>
                  {loko && <span class="loko">{loko}</span>}
                </div>
              </div>
            </div>

            {profilo.priskribo && <p class="priskribo">{profilo.priskribo}</p>}

            {(profilo.interesoj.length > 0 || profilo.lingvoj.length > 0) && (
              <div class="detaloj">
                {profilo.interesoj.length > 0 && (
                  <div>
                    <h2 class="etikedo">{t("profilo.interesoj")}</h2>
                    <ul class="blatoj">
                      {profilo.interesoj.map((i) => (
                        <li>{tradukiDinamike(lingvo, `intereso.${i}`, i)}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {profilo.lingvoj.length > 0 && (
                  <div>
                    <h2 class="etikedo">{t("profilo.ankaux-parolas")}</h2>
                    <p class="lingvoj">
                      {profilo.lingvoj.map((l) => nomoDe("language", l, lingvo)).join(", ")}
                    </p>
                  </div>
                )}
              </div>
            )}

            <p class="gxisdatigita">
              {t("profilo.gxisdatigita")}: {gxisdatigita}
            </p>
          </section>

          <aside class="kontaktiloj" aria-labelledby="kie-trovi">
            <h2 id="kie-trovi">{t("profilo.kie-trovi")}</h2>
            {ligiloj.length === 0 ? (
              <p class="malplena">{t("profilo.neniuj-kontaktiloj")}</p>
            ) : (
              <ul class="karto listo">
                {ligiloj.map((l) => (
                  <li class:list={[{ sxlosita: l.sxlosita }]}>
                    <span class="tipo">{l.etikedo}</span>
                    {l.sxlosita ? (
                      <a class="seruro" href={ensalutaUrl}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                          <rect x="5" y="11" width="14" height="9" rx="2" />
                          <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                        </svg>
                        {t("profilo.sxlosita")}
                      </a>
                    ) : l.href ? (
                      <a href={l.href} rel="nofollow noopener noreferrer" target="_blank">
                        {l.teksto}
                      </a>
                    ) : (
                      <span class="valoro">{l.teksto}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {sxlositaj > 0 ? (
              <a class="pli-butono" href={ensalutaUrl}>
                {sxlositaj === 1
                  ? t("profilo.pli-kontaktiloj-unu")
                  : enmeti(t("profilo.pli-kontaktiloj"), { n: sxlositaj })}
              </a>
            ) : (
              profilo.pliPostEnsaluto && (
                <p class="sugesto">
                  <a href={ensalutaUrl}>{t("profilo.pli-post-ensaluto")}</a>
                </p>
              )
            )}
          </aside>
        </div>
      </main>
</Bazo>

<style>
  .profilo {
    max-width: 65rem;
    margin: 0 auto;
    padding: 1.5rem 2rem 2.5rem;
  }

  .supro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .reen {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .raporti {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: 10px;
    border: 1px solid #c9d3cb;
    background: var(--koloro-surfaco);
    color: var(--koloro-teksto-dua);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .raporti:hover {
    border-color: #a3361a;
    color: #a3361a;
  }

  .nur-posxtelefono {
    display: none;
  }

  .pli-butono {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-top: 0.75rem;
    padding: 0 1rem;
    border-radius: 12px;
    background: var(--koloro-akcento);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
    text-decoration: none;
  }

  .pli-butono:hover {
    background: var(--koloro-akcento-malhela);
    color: #fff;
  }

  @media (max-width: 47.99rem) {
    .profilo {
      padding: 0.75rem 1.25rem 2rem;
    }

    /* Kiel en la prototipo: nur sago kaj "Raporti" sen kadro. */
    .nur-labortablo {
      display: none;
    }

    /* La teksto "Reen al la rezultoj" restas por ekranlegiloj. */
    .reen span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .nur-posxtelefono {
      display: inline;
    }

    .reen {
      width: 44px;
      justify-content: center;
      color: var(--koloro-teksto);
    }

    .raporti {
      border: none;
      background: none;
      font-size: 0.9375rem;
    }

    /* Kiel en la prototipo: sen karto, avataro apud la nomo. */
    .profilo .karto.cxefa {
      padding: 0;
      border: none;
      background: none;
    }

    .profilo .identeco {
      flex-wrap: nowrap;
      gap: 1rem;
    }

    .profilo .avataro {
      width: 4.5rem;
      height: 4.5rem;
      font-size: 2rem;
    }

    .profilo h1 {
      font-size: 1.75rem;
    }
  }

  .avizo.sukceso {
    font-weight: 600;
  }

  .avizo.averto {
    background: #fbeae4;
    color: #85290f;
  }

  .avizo {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--rondo);
    background: var(--koloro-akcento-hela);
  }

  .kolumnoj {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .karto {
    background: var(--koloro-surfaco);
    border: 1px solid var(--koloro-rando);
    border-radius: 20px;
  }

  .cxefa {
    flex: 999 1 30rem;
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .identeco {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .avataro {
    flex: none;
    width: clamp(4.5rem, 12vw, 6rem);
    height: clamp(4.5rem, 12vw, 6rem);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d7ebdd;
    color: var(--koloro-akcento);
    font-family: var(--tiparo-titoloj);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 2.5rem);
    overflow: hidden;
  }

  .avataro img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nomo-bloko {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
  }

  .meta {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nivelo {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    background: var(--koloro-akcento-hela);
    color: var(--koloro-akcento);
  }

  .loko {
    color: var(--koloro-teksto-dua);
  }

  .priskribo {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 60ch;
    white-space: pre-line;
  }

  .detaloj {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .etikedo {
    margin: 0 0 0.625rem;
    font-family: var(--tiparo-korpo);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--koloro-teksto-dua);
  }

  .blatoj {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blatoj li {
    padding: 0.375rem 0.75rem;
    border-radius: 1rem;
    background: var(--koloro-fono);
    border: 1px solid var(--koloro-rando);
    font-size: 0.875rem;
  }

  .lingvoj {
    margin: 0;
  }

  .gxisdatigita {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--koloro-teksto-dua);
  }

  .kontaktiloj {
    flex: 1 1 18rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .kontaktiloj h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .listo {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .listo li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0 1.125rem;
    border-bottom: 1px solid #eef2ed;
  }

  .listo li:last-child {
    border-bottom: none;
  }

  .listo li.sxlosita {
    background: #f9faf7;
  }

  .tipo {
    font-weight: 500;
  }

  .listo a,
  .valoro {
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
    text-align: right;
  }

  .seruro {
    display: flex;
    min-height: 44px;
    text-decoration: none;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--koloro-teksto-dua);
  }

  .malplena,
  .sugesto {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--koloro-teksto-dua);
  }
</style>

<style>
  .listo a:not(.seruro) {
    color: var(--koloro-akcento);
    text-decoration: none;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .listo a:not(.seruro):hover {
    text-decoration: underline;
  }
</style>
