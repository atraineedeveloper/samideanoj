---
import Eraro404 from "../../components/Eraro404.astro";
import ModerigaPagxo from "../../components/ModerigaPagxo.astro";
import { traktiModeradon } from "../../lib/moderigaPagxo";

const rezulto = await traktiModeradon(Astro);
if (rezulto instanceof Response) return rezulto;
if (!rezulto) Astro.response.status = 404;
---

{rezulto ? <ModerigaPagxo {...rezulto} /> : <Eraro404 />}
