---
/**
 * La kapo, laŭ la prototipo (docs/fazo-2/prototipo/labortablo/).
 * En poŝtelefono la navigado estas en la malsupra breto (NavBreto.astro), do ĉi
 * tie restas nur la emblemo kaj la butono "Ensaluti" aŭ la avataro.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { tradukilo } from "../i18n/tradukoj";
import { estasModeriganto } from "../lib/moderigado";
import { aktivaSekcio } from "../lib/navigado";

const lingvo = Astro.currentLocale ?? "eo";
const t = tradukilo(lingvo);
const uzanto = Astro.locals.uzanto;
const sekcio = aktivaSekcio(Astro.url.pathname, uzanto?.slug ?? null);
const ensalutaUrl = `${getRelativeLocaleUrl(lingvo, "ensaluti")}?reveno=${encodeURIComponent(Astro.url.pathname)}`;
const surEnsaluto = sekcio === "profilo" && !uzanto;
---

<header class="kapo">
  <div class="kapo-interno">
    <a class="marko" href={getRelativeLocaleUrl(lingvo, "")}>
      <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2.5l2.9 6.2 6.6.7-4.9 4.5 1.4 6.6L12 17.2l-6 3.3 1.4-6.6-4.9-4.5 6.6-.7z"
          fill="currentColor"></path>
      </svg>
      <span>{t("retejo.nomo")}</span>
    </a>
    <nav aria-label={t("navigado.cxefa")} class="navigado">
      <a
        class="ligilo nur-labortablo"
        href={getRelativeLocaleUrl(lingvo, "")}
        aria-current={sekcio === "mapo" || sekcio === "sercxi" ? "page" : undefined}
      >
        {t("navigado.mapo-sercxado")}
      </a>
      {
        uzanto && estasModeriganto(uzanto.rolo) && (
          <a class="ligilo nur-labortablo" href={getRelativeLocaleUrl(lingvo, "moderigado")}>
            {t("navigado.moderigado")}
          </a>
        )
      }
      {
        uzanto ? (
          <>
            <a
              class="ligilo nur-labortablo"
              href={getRelativeLocaleUrl(lingvo, "mia-profilo")}
              aria-current={sekcio === "profilo" ? "page" : undefined}
            >
              {t("navigado.mia-profilo")}
            </a>
            <a
              class="avataro"
              href={getRelativeLocaleUrl(lingvo, `s/${uzanto.slug}`)}
              aria-label={t("navigado.mia-publika")}
              title={t("navigado.mia-publika")}
            >
              {uzanto.kromnomo.charAt(0).toUpperCase()}
            </a>
          </>
        ) : (
          !surEnsaluto && (
            <a class="butono" href={ensalutaUrl}>
              {t("navigado.ensaluti")}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>

<style>
  .kapo {
    background: var(--koloro-surfaco);
    border-bottom: 1px solid var(--koloro-rando);
  }

  .kapo-interno {
    max-width: 85rem;
    margin: 0 auto;
    padding: 0.875rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .marko {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--koloro-teksto);
    font-family: var(--tiparo-titoloj);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  .marko svg {
    color: var(--koloro-akcento);
  }

  .navigado {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ligilo {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: 10px;
    color: var(--koloro-teksto);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .ligilo:hover {
    background: var(--koloro-fono);
    color: var(--koloro-teksto);
  }

  .ligilo[aria-current="page"] {
    background: var(--koloro-akcento-hela);
    color: var(--koloro-akcento);
    font-weight: 600;
  }

  .avataro {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d7ebdd;
    color: var(--koloro-akcento);
    font-family: var(--tiparo-titoloj);
    font-weight: 700;
    text-decoration: none;
  }

  .avataro:hover {
    background: #c6e0cd;
    color: var(--koloro-akcento);
  }

  .butono {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 10px;
    background: var(--koloro-teksto);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .butono:hover {
    background: #000;
    color: #fff;
  }

  @media (max-width: 47.99rem) {
    .kapo-interno {
      padding: 0.75rem 1.25rem;
    }

    .nur-labortablo {
      display: none;
    }

    /* Kiel en la prototipo: kontura butono en poŝtelefono. */
    .butono {
      background: transparent;
      color: var(--koloro-teksto);
      border: 1px solid #c9d3cb;
    }

    .butono:hover {
      background: var(--koloro-fono);
      color: var(--koloro-teksto);
    }
  }
</style>
