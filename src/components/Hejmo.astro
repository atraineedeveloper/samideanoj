---
import { getRelativeLocaleUrl } from "astro:i18n";
import { env } from "cloudflare:workers";
import { enmeti, landaListo, nomoDe, tradukilo } from "../i18n/tradukoj";
import Bazo from "../layouts/Bazo.astro";
import { legiNombrojn } from "../lib/mapo";
import Mapo from "./Mapo.astro";

const lingvo = Astro.currentLocale ?? "eo";
const t = tradukilo(lingvo);
const uzanto = Astro.locals.uzanto;
const nombroj = await legiNombrojn(env.DB);
const sercxUrl = getRelativeLocaleUrl(lingvo, "sercxi");

const landoj = Object.entries(nombroj.landoj).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const landKvanto = landoj.length;
const sumo =
  nombroj.sumo === 1
    ? t("hejmo.sumo-unu")
    : enmeti(t("hejmo.sumo"), { n: nombroj.sumo, m: landKvanto });
const elektoj = landaListo(
  landoj.map(([k]) => k),
  lingvo,
);
---

<Bazo>
  <main class="hejmo">
    <section class="enkonduko">
      <h1>{t("hejmo.titolo")}</h1>
      <p class="subtitolo">{t("hejmo.subtitolo")}</p>

      <form method="get" action={sercxUrl} class="rapida" role="search">
        <label for="hejmo-lando" class="vide-kasxita">{t("sercxi.lando")}</label>
        <select id="hejmo-lando" name="lando">
          <option value="">{t("sercxi.cxiuj-landoj")}</option>
          {elektoj.map((l) => <option value={l.kodo}>{l.nomo}</option>)}
        </select>
        <button type="submit">{t("sercxi.butono")}</button>
      </form>

      {nombroj.sumo > 0 && <p class="sumo">{sumo}</p>}

      {
        landoj.length > 0 && (
          <nav aria-label={t("mapo.landoj")} class="landoj">
            <ul>
              {landoj.slice(0, 12).map(([kodo, n]) => (
                <li>
                  <a href={`${sercxUrl}?lando=${kodo}`}>
                    {nomoDe("region", kodo, lingvo)} <span>{n}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={sercxUrl} class="cxiuj">
              {t("hejmo.vidi-cxiujn")} →
            </a>
          </nav>
        )
      }

      {
        !uzanto && (
          <a class="aligxi" href={getRelativeLocaleUrl(lingvo, "ensaluti")}>
            {t("hejmo.aligxi")}
          </a>
        )
      }
    </section>

    <section class="mapujo" aria-label={t("mapo.titolo")}>
      <Mapo nombroj={nombroj} lando={null} />
      <p class="mapa-helpo">{t("mapo.priskribo")}</p>
    </section>
  </main>
</Bazo>

<style>
  .hejmo {
    max-width: 85rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .hejmo {
      grid-template-columns: minmax(20rem, 26rem) minmax(0, 1fr);
      align-items: start;
      gap: 2.5rem;
    }
  }

  .enkonduko {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
  }

  .subtitolo {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--koloro-teksto-dua);
  }

  .rapida {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .rapida select {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0 0.75rem;
    border: 1px solid #c9d3cb;
    border-radius: 12px;
    background: #fff;
    font: inherit;
    color: var(--koloro-teksto);
  }

  .rapida button {
    min-height: 3rem;
    padding: 0 1.25rem;
    border: none;
    border-radius: 12px;
    background: var(--koloro-akcento);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .rapida button:hover {
    background: var(--koloro-akcento-malhela);
  }

  .sumo {
    margin: 0;
    font-family: var(--tiparo-titoloj);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .landoj ul {
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .landoj ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid #c9d3cb;
    border-radius: 999px;
    background: var(--koloro-surfaco);
    color: var(--koloro-teksto);
    text-decoration: none;
    font-weight: 500;
  }

  .landoj ul a:hover {
    border-color: var(--koloro-akcento);
  }

  .landoj ul span {
    color: var(--koloro-akcento);
    font-weight: 700;
  }

  .cxiuj {
    font-weight: 600;
  }

  .aligxi {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    background: var(--koloro-teksto);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .aligxi:hover {
    background: #000;
    color: #fff;
  }

  .mapa-helpo {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--koloro-teksto-dua);
  }
</style>
