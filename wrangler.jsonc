// Agordo de Cloudflare Workers. Vidu ADR 0002 kaj docs/disvolvado.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samideanoj",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // MEDIO identigas la medion dum rultempo. PROVA_ENSALUTO ebligas ensaluti kiel
  // ekzempla uzanto sen provizanto: NUR loke kaj en la provmedio, NENIAM en produktado
  // (kontrolata de tests/agordo.test.ts).
  "vars": { "MEDIO": "loka", "PROVA_ENSALUTO": "jes" },

  // Loka disvolvado uzas lokan D1-kopion; la identigilo ĉi tie ne gravas loke.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samideanoj",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Rapidlimo por la serĉado kaj la profiloj: 60 petoj minute por IP-adreso
  // (src/middleware.ts). Senpaga. namespace_id estas unika en la konto.
  "ratelimits": [
    { "name": "PROFILA_LIMIGILO", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "env": {
    // Provmedio: deplojata aŭtomate post ĉiu kunfando en main.
    "provmedio": {
      "name": "samideanoj-provmedio",
      "vars": { "MEDIO": "provmedio", "PROVA_ENSALUTO": "jes" },
      "ratelimits": [
        {
          "name": "PROFILA_LIMIGILO",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "samideanoj-provmedio",
          "database_id": "484a80b4-71e3-45cd-8446-2608444032f3",
          "migrations_dir": "migrations"
        }
      ]
    },
    // Produktado: deplojata nur per mana aprobo.
    "produktado": {
      "name": "samideanoj",
      "vars": { "MEDIO": "produktado" },
      "ratelimits": [
        {
          "name": "PROFILA_LIMIGILO",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "samideanoj-produktado",
          "database_id": "b1661950-64b9-46e1-8cb2-76a85c2655a5",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
