---
import Eraro404 from "../../components/Eraro404.astro";
import ProfiloPagxo from "../../components/ProfiloPagxo.astro";
import { sxargiVideblanProfilon } from "../../lib/profilaPagxo";

const profilo = await sxargiVideblanProfilon(Astro.params.slug, Astro.locals.rigardanto);
if (!profilo) Astro.response.status = 404;
---

{profilo ? <ProfiloPagxo profilo={profilo} /> : <Eraro404 />}
